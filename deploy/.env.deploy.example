# 複製成 deploy/.env.deploy（已被 .gitignore 排除），填好後 release.sh 會把它推到 VM：
#   cp deploy/.env.deploy.example deploy/.env.deploy

# 對外網域（Cloudflare DNS A 記錄指到 VM 外部 IP，DNS only 灰雲，見 deploy/README.md）
DEPLOY_DOMAIN=codefest.ciyang.dev

# Postgres 密碼，用這行產生後貼上（hex 字元，可直接放進連線字串）：
#   openssl rand -hex 16
# 只在 db volume 第一次建立時生效；之後改這裡不會改到既有資料庫的密碼
DB_PASSWORD=CHANGE_ME_openssl_rand_hex_16

# data.taipei 範例資料集 resource id（留空 = /api/v1/opendata/sample 回內建 mock）
OPENDATA_SAMPLE_RID=a6e90031-7ec4-4089-afb5-361a4efe7202
