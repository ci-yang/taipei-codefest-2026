# 複製成 .env：cp .env.example .env
# Postgres/PostGIS（docker compose 的 db 服務對外開 5433，避免撞到本機既有的 5432）
DATABASE_URL=postgres://app:app@localhost:5433/app

# API（Hono）監聽的 port。3000 常被其他服務佔用，所以預設 8787
API_PORT=8787

# Web（Vite）呼叫 API 的 base URL。
# 留空 = 走 Vite dev proxy（/api、/healthz 轉到 API_PORT），手機連開發機時最省事
VITE_API_BASE=

# API 的 CORS 允許來源（逗號分隔）。手機用 IP 連時把 http://<你的區網IP>:5173 加進來
PUBLIC_WEB_URL=http://localhost:5173

# data.taipei 範例資料集的 resource id（/api/v1/opendata/sample 用）
# 預設：臺北市垃圾車點位路線資訊（4012 筆，2026-11-07 實測可用，見 docs/open-data-catalog.md）
# 留空 = 一律回內建 mock
OPENDATA_SAMPLE_RID=a6e90031-7ec4-4089-afb5-361a4efe7202

# Cloudflare：本機使用 wrangler login；自動化時只在環境／Actions secrets 設 token。
# account、D1 binding、DATA_VERSION 的非敏感設定在 wrangler.jsonc。
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# 獨立 TownPass repo 建置入口（部署成功後填已驗證的 HTTPS URL）
TOWNPASS_DIR=
CODEFEST_SERVICE_URL=
